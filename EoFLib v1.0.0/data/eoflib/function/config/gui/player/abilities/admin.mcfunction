#> eoflib:config/gui/player/abilities/admin
#
# Display admin-targeted messages.

#region
    # Debug
execute if entity @s run tellraw @s[tag=eoflib.debug, scores={eoflib.debug_mode=2..}] [{"text": "[", "color": "dark_gray"}, {"text": "Debug", "color": "gold"}, {"text": "] - ", "color": "dark_gray"}, {"text": "eoflib:abilities/admin.mcf", "color": "gold", "hover_event": {"action": "show_text", "value": {"text": "You ran the following function:\n- eoflib:config/gui/player/abilities/admin.mcfunction", "color": "aqua"}}}]
execute if entity @s at @s run tellraw @a[tag=eoflib.debug, scores={eoflib.debug_mode=3..}, distance=0.1..] [{"text": "[", "color": "dark_gray"}, {"text": "Debug", "color": "gold"}, {"text": "] - ", "color": "dark_gray"}, {"text": "eoflib:abilities/admin.mcf", "color": "#967228", "hover_event": {"action": "show_text", "value": [{"selector": "@s", "color": "aqua"}, {"text": " ran the following function:\n- eoflib:config/gui/player/abilities/admin.mcfunction", "color": "aqua"}]}}]
execute unless entity @s run tellraw @a[tag=eoflib.debug, scores={eoflib.debug_mode=2..}] [{"text": "[", "color": "dark_gray"}, {"text": "Debug", "color": "gold"}, {"text": "] - ", "color": "dark_gray"}, {"text": "eoflib:abilities/admin.mcf", "color": "gray", "hover_event": {"action": "show_text", "value": {"text": "Server ran the following function:\n- eoflib:config/gui/player/abilities/admin.mcfunction", "color": "aqua"}}}]

    # Fail
        ## No Tribe
            ### AS: Disable Abilities
execute unless predicate eoflib:tribes/dragon if predicate eoflib:settings/admin/allow_abilities run tellraw @s [{"text": "[", "color": "gray"}, {"text": "❌", "color": "dark_gray", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Enable your tribal abilities.\n\nYou are not a member of any tribes.", "color": "dark_gray"}}, "click_event": {"action": "suggest_command", "command": "/team join team"}}, {"text": "] [", "color": "gray"}, {"text": "AS", "color": "gold"}, {"text": ": ", "color": "gray"}, {"text": "✔", "color": "green", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Disable the ability for non-admin players to\ntoggle their abilities.", "color": "red"}}, "click_event": {"action": "run_command", "command": "/execute if entity @s[tag=eoflib.admin] run trigger eoflib.trigger set 32"}}, {"text": "] ", "color": "gray"}, {"text": "Enable Tribe Abilities", "color": "dark_gray", "strikethrough": true, "hover_event": {"action": "show_text", "value": {"text": "Toggle on or off your hotbar abilities.", "color": "dark_gray"}}}]

            ### AS: Enable Abilities
execute unless predicate eoflib:tribes/dragon unless predicate eoflib:settings/admin/allow_abilities run tellraw @s [{"text": "[", "color": "gray"}, {"text": "❌", "color": "dark_gray", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Enable your tribal abilities.\n\nYou are not a member of any tribes.", "color": "dark_gray"}}, "click_event": {"action": "suggest_command", "command": "/team join team"}}, {"text": "] [", "color": "gray"}, {"text": "AS", "color": "gold"}, {"text": ": ", "color": "gray"}, {"text": "❌", "color": "red", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Enable the ability for non-admin players to\ntoggle their abilities.", "color": "green"}}, "click_event": {"action": "run_command", "command": "/execute if entity @s[tag=eoflib.admin] run trigger eoflib.trigger set 32"}}, {"text": "] ", "color": "gray"}, {"text": "Enable Tribe Abilities", "color": "dark_gray", "strikethrough": true, "hover_event": {"action": "show_text", "value": {"text": "Toggle on or off your hotbar abilities.", "color": "dark_gray"}}}]
    # Success
        ## Disable
            ### AS: Disable Abilities
execute if entity @s[tag=eoflib.abilities, predicate=eoflib:tribes/dragon] if predicate eoflib:settings/admin/allow_abilities run tellraw @s [{"text": "[", "color": "gray"}, {"text": "✔", "color": "green", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Disable your tribal abilities.", "color": "red"}}, "click_event": {"action": "run_command", "command": "/trigger eof.abilities set 2"}}, {"text": "] [", "color": "gray"}, {"text": "AS", "color": "gold"}, {"text": ": ", "color": "gray"}, {"text": "✔", "color": "green", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Disable the ability for non-admin players to\ntoggle their abilities.", "color": "red"}}, "click_event": {"action": "run_command", "command": "/execute if entity @s[tag=eoflib.admin] run trigger eoflib.trigger set 32"}}, {"text": "] ", "color": "gray"}, {"text": "Enable Tribe Abilities", "hover_event": {"action": "show_text", "value": {"text": "Toggle on or off your hotbar abilities.", "color": "gray"}}}]

        ## AS: Enable Abilities
execute if entity @s[tag=eoflib.abilities, predicate=eoflib:tribes/dragon] unless predicate eoflib:settings/admin/allow_abilities run tellraw @s [{"text": "[", "color": "gray"}, {"text": "✔", "color": "green", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Disable your tribal abilities.", "color": "red"}}, "click_event": {"action": "run_command", "command": "/trigger eof.abilities set 2"}}, {"text": "] [", "color": "gray"}, {"text": "AS", "color": "gold"}, {"text": ": ", "color": "gray"}, {"text": "❌", "color": "red", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Enable the ability for non-admin players to\ntoggle their abilities.", "color": "green"}}, "click_event": {"action": "run_command", "command": "/execute if entity @s[tag=eoflib.admin] run trigger eoflib.trigger set 32"}}, {"text": "] ", "color": "gray"}, {"text": "Enable Tribe Abilities", "hover_event": {"action": "show_text", "value": {"text": "Toggle on or off your hotbar abilities.", "color": "gray"}}}]

    # Success: Enable
        ## AS: Disable Abilities
execute if entity @s[tag=!eoflib.abilities, predicate=eoflib:tribes/dragon] if predicate eoflib:settings/admin/allow_abilities run tellraw @s [{"text": "[", "color": "gray"}, {"text": "❌", "color": "red", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Enable your tribal abilities.", "color": "green"}}, "click_event": {"action": "run_command", "command": "/trigger eof.abilities set 2"}}, {"text": "] [", "color": "gray"}, {"text": "AS", "color": "gold"}, {"text": ": ", "color": "gray"}, {"text": "✔", "color": "green", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Disable the ability for non-admin players to\ntoggle their abilities.", "color": "red"}}, "click_event": {"action": "run_command", "command": "/execute if entity @s[tag=eoflib.admin] run trigger eoflib.trigger set 32"}}, {"text": "] ", "color": "gray"}, {"text": "Enable Tribe Abilities", "hover_event": {"action": "show_text", "value": {"text": "Toggle on or off your hotbar abilities.", "color": "gray"}}}]

        ## AS: Enable Abilities
execute if entity @s[tag=!eoflib.abilities, predicate=eoflib:tribes/dragon] unless predicate eoflib:settings/admin/allow_abilities run tellraw @s [{"text": "[", "color": "gray"}, {"text": "❌", "color": "red", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Enable your tribal abilities.", "color": "green"}}, "click_event": {"action": "run_command", "command": "/trigger eof.abilities set 2"}}, {"text": "] [", "color": "gray"}, {"text": "AS", "color": "gold"}, {"text": ": ", "color": "gray"}, {"text": "❌", "color": "red", "underlined": true, "hover_event": {"action": "show_text", "value": {"text": "Enable the ability for non-admin players to\ntoggle their abilities.", "color": "green"}}, "click_event": {"action": "run_command", "command": "/execute if entity @s[tag=eoflib.admin] run trigger eoflib.trigger set 32"}}, {"text": "] ", "color": "gray"}, {"text": "Enable Tribe Abilities", "hover_event": {"action": "show_text", "value": {"text": "Toggle on or off your hotbar abilities.", "color": "gray"}}}]

#endregion
